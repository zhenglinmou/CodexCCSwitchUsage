{
  "server": {
    "host": "127.0.0.1",
    "port": 17891
  },
  "browser": {
    "channel": "msedge",
    "headless": true,
    "persistent": false
  },
  "providers": [
    {
      "id": "anyrouter",
      "name": "AnyRouter（国外入口）",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "anyrouter",
      "cc_switch_provider_id": "replace-with-anyrouter-provider-id",
      "timeout_seconds": 60
    },
    {
      "id": "anyrouter_cn",
      "name": "AnyRouter（国内镜像）",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "anyrouter",
      "cc_switch_provider_id": "replace-with-anyrouter_cn-provider-id",
      "timeout_seconds": 60
    },
    {
      "id": "openai_official",
      "name": "OpenAI Official",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "openai",
      "cc_switch_provider_id": "replace-with-openai_official-provider-id",
      "timeout_seconds": 40
    },
    {
      "id": "openai_personal",
      "name": "OpenAI Official-我自己的",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "openai",
      "cc_switch_provider_id": "replace-with-openai_personal-provider-id",
      "timeout_seconds": 40
    },
    {
      "id": "packycode",
      "name": "PackyCode",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "packy",
      "cc_switch_provider_id": "replace-with-packycode-provider-id",
      "timeout_seconds": 40
    },
    {
      "id": "paid_rawchat",
      "name": "付费站",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "paid_window",
      "cc_switch_provider_id": "replace-with-paid_rawchat-provider-id",
      "primary_limit": "1d",
      "limit_windows": [
        {
          "id": "3h",
          "label": "3小时滚动窗口",
          "window_seconds": 10800,
          "remaining_path": "balance_3h",
          "used_path": "used_3h",
          "total_path": "limit_3h",
          "reset_at_path": "rolling_window_end",
          "unit": "USD"
        },
        {
          "id": "1d",
          "label": "24小时额度",
          "window_seconds": 86400,
          "remaining_path": "balance_1d",
          "used_path": "used_1d",
          "total_path": "limit_1d",
          "reset_at_path": "daily_cycle_end",
          "unit": "USD"
        }
      ],
      "timeout_seconds": 40
    },
    {
      "id": "paid_sharedchat",
      "name": "付费站 copy",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "paid_window",
      "cc_switch_provider_id": "replace-with-paid_sharedchat-provider-id",
      "primary_limit": "1d",
      "limit_windows": [
        {
          "id": "3h",
          "label": "3小时滚动窗口",
          "window_seconds": 10800,
          "remaining_path": "balance_3h",
          "used_path": "used_3h",
          "total_path": "limit_3h",
          "reset_at_path": "rolling_window_end",
          "unit": "USD"
        },
        {
          "id": "1d",
          "label": "24小时额度",
          "window_seconds": 86400,
          "remaining_path": "balance_1d",
          "used_path": "used_1d",
          "total_path": "limit_1d",
          "reset_at_path": "daily_cycle_end",
          "unit": "USD"
        }
      ],
      "timeout_seconds": 40
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "deepseek",
      "cc_switch_provider_id": "replace-with-deepseek-provider-id",
      "timeout_seconds": 40
    },
    {
      "id": "chy",
      "name": "CHY公益站（目前无）",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "health_only",
      "cc_switch_provider_id": "replace-with-chy-provider-id",
      "timeout_seconds": 40
    },
    {
      "id": "cpa",
      "name": "官方对接的 CPA",
      "enabled": true,
      "adapter": "python_plugin",
      "plugin": "plugins/ccswitch_balance.py",
      "mode": "cpa_accounts",
      "cc_switch_provider_id": "replace-with-cpa-provider-id",
      "timeout_seconds": 60
    },
    {
      "id": "agentrouter",
      "name": "AgentRouter",
      "enabled": true,
      "adapter": "browser_fetch",
      "base_url": "https://agentrouter.org",
      "login_path": "/login",
      "login_supported": false,
      "navigate_request": true,
      "request_count_in_extra": false,
      "cookie_file": "${ENV:LOCALAPPDATA}\\CCSwitchWafBalanceBridge\\agentrouter-cookie.txt",
      "waf_wait_seconds": 35,
      "cc_switch_provider_id": "replace-with-agentrouter-provider-id",
      "cc_switch_credentials": {
        "token_field": "accessToken",
        "user_id_field": "userId",
        "token_header": "Authorization",
        "token_prefix": "Bearer "
      },
      "timeout_seconds": 85,
      "request": {
        "path": "/api/user/self",
        "method": "GET",
        "headers": {
          "Accept": "application/json, text/plain, */*",
          "Cache-Control": "no-store"
        },
        "browser_user_header": "New-Api-User"
      },
      "response": {
        "success": {
          "path": "success",
          "equals": true
        },
        "message_paths": [
          "message",
          "error.message"
        ],
        "valid": {
          "path": "data.status",
          "not_equals": 0,
          "missing": true
        },
        "fields": {
          "planName": {
            "path": "data.group",
            "default": "AgentRouter"
          },
          "remaining": {
            "path": "data.quota",
            "divisor": 500000
          },
          "used": {
            "path": "data.used_quota",
            "divisor": 500000
          },
          "total": {
            "paths": [
              "data.quota",
              "data.used_quota"
            ],
            "aggregate": "sum",
            "divisor": 500000
          },
          "unit": {
            "default": "USD"
          },
          "requestCount": {
            "path": "data.request_count",
            "default": 0
          },
          "extra": {
            "default": ""
          }
        }
      }
    }
  ]
}
